# Copy to .env and fill in. The real .env must never be committed.
# .env.example IS committed, so it contains placeholders only.
#
#   cp .env.example .env && $EDITOR .env
#   set -a; . ./.env; set +a
#
# The FastAPI backend auto-loads a .env file from its own directory
# (siem-backend/.env) if one exists, so exporting is optional for it.
# The Docker Compose stack reads compose/.env.

# Wazuh manager API (the "wazuh-wui" user created on the manager)
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=change-me
# Where the backend reaches the manager API
WAZUH_API_HOST=https://localhost:55000

# Wazuh indexer / OpenSearch (the backend reads alerts straight from it)
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=change-me
XSIEM_INDEXER_URL=https://localhost:9200
XSIEM_INDEXER_INDEX=wazuh-alerts-*

# Wazuh dashboard (OpenSearch Dashboards) login
WAZUH_DASHBOARD_USER=kibanaserver
WAZUH_DASHBOARD_PASSWORD=change-me

# Lab target account used for the detection payloads
XSIEM_TARGET=192.168.49.1
XSIEM_TARGET_USER=xsiem_test
XSIEM_TARGET_PASSWORD=change-me

# Optional: only needed for the admin-assisted payloads
# (user_account_created, privileged_group_change). The Kali side deliberately
# does not hold admin rights on the monitored endpoint; leave these unset and
# the tool prints the command for an operator to run instead.
#XSIEM_ADMIN_USER=
#XSIEM_ADMIN_PASSWORD=

# Lab server
XSIEM_SERVER=192.168.49.128
XSIEM_API_URL=http://192.168.49.128:4000
XSIEM_DASHBOARD_URL=http://192.168.49.128:3000

# Comma separated list of dashboard origins the backend accepts (CORS)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.49.128:3000

# The browser-side API base URL baked into the React build (CRA only exposes
# REACT_APP_* variables to the browser). Must be reachable from the browser.
REACT_APP_API_BASE=http://192.168.49.128:4000

# Optional: email alerting for HIGH severity alerts (Gmail App Password)
#EMAIL_SENDER=
#EMAIL_PASSWORD=
#EMAIL_RECEIVER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
